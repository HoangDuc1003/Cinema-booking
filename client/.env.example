# Copy to `client/.env.local`. Every `VITE_*` value is bundled into the browser,
# so never put a secret in one.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=<clerk_publishable_key>
# Backend URL. TMDB is called through the backend, so no TMDB key lives here.
VITE_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------
VITE_CURRENCY=$
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original
# Serve bundled mock movies when the API is unreachable (local development only).
VITE_ENABLE_MOCK_DATA=false
VITE_HERO_API_TIMEOUT_MS=12000
VITE_HOME_NOW_SHOWING_API_TIMEOUT_MS=12000
VITE_HOME_NOW_SHOWING_REQUEST_BUDGET_MS=14000
VITE_TRAILER_API_TIMEOUT_MS=12000
VITE_SHOWTIME_API_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Production only: Clerk proxy on Vercel (client/api/clerk-proxy.js)
# ---------------------------------------------------------------------------
# Leave empty locally. Production builds already default to /__clerk.
VITE_CLERK_PROXY_URL=
# Server-side Vercel Function variables; never prefix these with VITE_.
CLERK_PROXY_URL=https://nitrocine.vercel.app/__clerk
CLERK_FAPI=https://frontend-api.clerk.dev
CLERK_SECRET_KEY=<server_only_clerk_secret_key>
