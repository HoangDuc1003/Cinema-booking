# Runtime
PORT=3000
# Required in production. Used only for validated Stripe success/cancel redirects.
CLIENT_URL=http://localhost:5173
# Optional comma-separated additions to the explicit CORS allowlist.
# The production app origin is built in; local Vite origins are enabled outside production.
CORS_ALLOWED_ORIGINS=

# Native Hero rotation
HERO_REFRESH_TIMEZONE=Asia/Ho_Chi_Minh
HERO_REFRESH_INTERVAL_HOURS=48
HERO_DEFAULT_VOLUME=0.35
HERO_REQUIRE_NATIVE_VIDEO=true
HERO_VIDEO_ALLOWED_HOSTS=res.cloudinary.com
HERO_VIDEO_MAX_BYTES=104857600
HERO_VIDEO_MAX_DURATION_SECONDS=180
HERO_VIDEO_MIN_WIDTH=640
HERO_VIDEO_MIN_HEIGHT=360
HERO_VIDEO_ORPHAN_GRACE_SECONDS=3600
HERO_MIN_VOTE_AVERAGE=7
HERO_MIN_VOTE_COUNT=300

# MongoDB Atlas or another replica set (transactions are required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Redis. Keep the real URL only in the deployment environment or local .env.
REDIS_URL=rediss://:<password>@<host>:<port>
REDIS_KEY_PREFIX=nitrocine
# Bounded to 100-30000ms.
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RECONNECT_ATTEMPTS=1
REDIS_COMMAND_TIMEOUT_MS=2000

# Cache TTLs (seconds)
CACHE_MOVIES_TTL_SECONDS=300
CACHE_HOME_NOW_SHOWING_LAST_GOOD_TTL_SECONDS=86400
CACHE_HERO_ACTIVE_TTL_SECONDS=172800
CACHE_HERO_LAST_GOOD_TTL_SECONDS=604800
CACHE_MOVIE_TTL_SECONDS=1800
CACHE_CINEMAS_TTL_SECONDS=600
CACHE_SHOWTIMES_TTL_SECONDS=120
CACHE_SEAT_MAP_TTL_SECONDS=5

# Coordination and idempotency
# Minimum 1860: Stripe Checkout requires >=30 minutes; 60 seconds is a safety buffer.
SEAT_HOLD_TTL_SECONDS=1860
BOOKING_LOCK_TTL_MS=10000
PAYMENT_LOCK_TTL_MS=30000
PAYMENT_IDEMPOTENCY_TTL_SECONDS=604800
CATALOG_REFRESH_LOCK_TTL_MS=120000
CATALOG_REFRESH_JOB_TTL_SECONDS=86400
HERO_REFRESH_LOCK_TTL_MS=120000
HERO_REFRESH_RUN_TTL_SECONDS=604800

# Clerk
CLERK_PUBLISHABLE_KEY=<clerk_publishable_key>
CLERK_SECRET_KEY=<clerk_secret_key>

# TMDB (server-side bearer token)
TMDB_API_KEY=<tmdb_bearer_token>
TMDB_REGION=VN
TMDB_TIMEOUT_MS=3000
TMDB_IMAGE_TIMEOUT_MS=6000
TMDB_NOW_PLAYING_SHOW_PRICE=100
NOW_PLAYING_SYNC_LOCK_TTL_MS=300000
# Explicit demo-only fallback: materializes persisted seven-day shows on a movie details request.
# If omitted, it auto-enables only when CLERK_PUBLISHABLE_KEY starts with pk_test_.
DEMO_SHOWTIMES_ENABLED=false

# Cloudinary native Hero trailers
CLOUDINARY_NAME=<cloudinary_cloud_name>
CLOUDINARY_API_KEY=<cloudinary_api_key>
CLOUDINARY_SECRET_KEY=<cloudinary_api_secret>

# Stripe. Keep real values in local/deployment environment variables only.
STRIPE_PUBLISHABLE_KEY=<stripe_publishable_key>
STRIPE_SECRET_KEY=<stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<stripe_webhook_secret>

# Inngest
INNGEST_EVENT_KEY=<inngest_event_key>
INNGEST_SIGNING_KEY=<inngest_signing_key>

# Integration tests: use disposable infrastructure only
ALLOW_INTEGRATION_TESTS=false
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/nitrocine_test?replicaSet=rs0
