# Copy to `server/.env` and fill in real values. Never commit the real file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
PORT=3000
# Frontend origin. Used for CORS and for validated Stripe success/cancel redirects.
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or another replica set: seat booking uses multi-document transactions.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Clerk authentication (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=<clerk_publishable_key>
CLERK_SECRET_KEY=<clerk_secret_key>

# TMDB API Read Access Token (v4 bearer token, https://www.themoviedb.org/settings/api)
TMDB_API_KEY=<tmdb_bearer_token>

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=<stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<stripe_webhook_secret>

# ---------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------
# Redis caches reads and coordinates seat holds. Without it browsing and booking
# still work (slower, MongoDB stays the source of truth), but the admin catalog
# refresh needs it.
REDIS_URL=rediss://:<password>@<host>:<port>
# Give each environment its own prefix when several share one Redis instance.
REDIS_KEY_PREFIX=nitrocine

# Inngest background jobs (daily showtime sync, hold expiry). Read by the Inngest SDK.
INNGEST_EVENT_KEY=<inngest_event_key>
INNGEST_SIGNING_KEY=<inngest_signing_key>

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# Extra comma-separated CORS origins. Local Vite origins are allowed outside production.
CORS_ALLOWED_ORIGINS=

# Mock showtimes for the Hero and Now Showing movies. Set to false to turn them off.
DEMO_SHOWTIMES_ENABLED=true
TMDB_NOW_PLAYING_SHOW_PRICE=100
TMDB_TIMEOUT_MS=3000
TMDB_IMAGE_TIMEOUT_MS=6000

MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=15000

REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RECONNECT_ATTEMPTS=1
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_PUBLIC_CACHE_TIMEOUT_MS=

# Cache TTLs (seconds)
CACHE_MOVIES_TTL_SECONDS=300
CACHE_MOVIE_TTL_SECONDS=1800
# Translated titles and synopses (Hero, Now Showing and trailers follow the viewer country language)
CACHE_MOVIE_TITLES_TTL_SECONDS=604800
CACHE_CINEMAS_TTL_SECONDS=600
CACHE_SHOWTIMES_TTL_SECONDS=120
CACHE_SEAT_MAP_TTL_SECONDS=5
CACHE_HOME_NOW_SHOWING_LAST_GOOD_TTL_SECONDS=86400
CACHE_NOW_SHOWING_LAST_GOOD_TTL_SECONDS=2592000
CACHE_TMDB_TRAILER_TTL_SECONDS=86400
CACHE_TMDB_TRAILER_NEGATIVE_TTL_SECONDS=3600

# Seat holds, locks and idempotency
# Minimum 1860: Stripe Checkout sessions last at least 30 minutes, plus a 60 second buffer.
SEAT_HOLD_TTL_SECONDS=1860
BOOKING_LOCK_TTL_MS=10000
PAYMENT_LOCK_TTL_MS=30000
PAYMENT_IDEMPOTENCY_TTL_SECONDS=604800
CATALOG_REFRESH_LOCK_TTL_MS=120000
CATALOG_REFRESH_JOB_TTL_SECONDS=86400
NOW_PLAYING_SYNC_LOCK_TTL_MS=300000

# ---------------------------------------------------------------------------
# Tests (disposable infrastructure only)
# ---------------------------------------------------------------------------
ALLOW_INTEGRATION_TESTS=false
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/nitrocine_test?replicaSet=rs0
